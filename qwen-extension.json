{
  "name": "atlas-family",
  "version": "0.1.0-beta.4",
  "description": "Create, edit and verify native loadable Revit families. Requires Atlas Core.",
  "mcpServers": {
    "atlas_family": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${extensionPath}/scripts/atlas-mcp.ps1",
        "-Surface",
        "family"
      ]
    }
  }
}
