{
  "name": "atlas-family",
  "version": "2.0.0-alpha.1",
  "description": "Create, edit and verify native loadable Revit families. Requires Atlas Core.",
  "mcpServers": {
    "atlas_family": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "${extensionPath}/scripts/atlas-mcp.ps1",
        "-Surface",
        "family",
        "-Interface",
        "v2-candidate"
      ]
    }
  }
}
